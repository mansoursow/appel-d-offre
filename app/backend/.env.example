# ===========================================================================
# Variables d'environnement du backend -- copier en `.env` et adapter.
# Aucune valeur reelle ne doit etre versionnee dans Git.
# ===========================================================================

# --- Securite (OBLIGATOIRE en production) ---------------------------------
# Cle de signature des jetons de session. La generer une fois avec :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Si elle change, tout le monde est deconnecte. Ne jamais la partager.
SECRET_KEY=

# Duree d'une session, en secondes (43200 = 12 h).
TOKEN_TTL_SECONDS=43200

# --- Donnees ---------------------------------------------------------------
# Base SQLite. En production, la placer sur le VOLUME PERSISTANT du serveur,
# sinon elle est effacee a chaque redeploiement (comptes et historique perdus).
DATABASE_URL=sqlite:////var/data/tenders.db

# Dossier des fichiers envoyes (photos de journaux, offres deposees).
# Egalement a placer sur le volume persistant.
UPLOAD_DIR=/var/data/uploads

# Emplacement de la cle de signature si SECRET_KEY n'est pas renseignee.
SECRET_KEY_FILE=/var/data/.secret_key

# --- Frontend --------------------------------------------------------------
# Origines autorisees a appeler l'API depuis un navigateur. Inutile si le
# backend sert lui-meme l'interface (cas par defaut en production).
# CORS_ORIGINS=https://app.adoc-consulting.com

# Dossier du frontend compile. La valeur par defaut (../frontend/dist)
# convient, sauf image Docker qui le place ailleurs.
# FRONTEND_DIST=/app/frontend_dist

# --- Reglages metier -------------------------------------------------------
# Jours ou l'assistante doit deposer les journaux (0 = lundi ... 6 = dimanche).
JOURNAL_WORKING_DAYS=0,1,2,3,4,5

# Alerte dossier incomplet : nombre de jours avant la date limite.
DOC_ALERT_DAYS_BEFORE_DEADLINE=3

# Taille maximale d'un fichier envoye, en Mo.
MAX_UPLOAD_MB=25

# --- E-mails de notification (optionnel) -----------------------------------
# Un avis retenu declenche un e-mail au responsable du montage. Railway bloque
# le SMTP sur les offres Free/Hobby : utiliser Brevo ou Resend (API HTTPS).
# EMAIL_FROM doit etre une adresse du domaine valide chez le service choisi.
EMAIL_FROM=Veille AO <veille@adoc-consulting.com>
BREVO_API_KEY=
RESEND_API_KEY=
# SMTP (developpement local ou Railway Pro uniquement)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Lien "ouvrir le site" place dans les e-mails
APP_PUBLIC_URL=https://app.adoc-consulting.com

# --- Recherche LinkedIn (optionnel) ----------------------------------------
# Sans cle, la source LinkedIn reste en erreur : DuckDuckGo bloque les robots.
# Conseille : SERPER_API_KEY (compte sur https://serper.dev, onglet API Key).
SERPER_API_KEY=
SERPAPI_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
